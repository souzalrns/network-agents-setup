# Server
PORT=3000
NODE_ENV=development
PUBLIC_MODE=false
LOG_LEVEL=info
API_KEY=your-super-secret-api-key

# Database
DATABASE_URL=postgresql://network:network123@localhost:5432/network_agents

# Redis
REDIS_URL=redis://localhost:6379

# LLM Providers
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
DEFAULT_MODEL=gpt-4-turbo

# MCP
FILESYSTEM_BASE=./data

# HITL
HITL_EXPIRE_MINUTES=60

# Observability
OTLP_ENDPOINT=
SERVICE_NAME=network-agents
