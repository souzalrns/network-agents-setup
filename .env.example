# Server
PORT=3000
NODE_ENV=development
PUBLIC_MODE=false
LOG_LEVEL=info
API_KEY=your-super-secret-api-key

# Database
DATABASE_URL=postgresql://network:CHANGE_ME@localhost:5432/network_agents

# Redis
REDIS_URL=redis://localhost:6379

# LLM Providers
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
DEFAULT_MODEL=gpt-4-turbo

# MCP
FILESYSTEM_BASE=./data

# HITL
HITL_EXPIRE_MINUTES=60

# Observability
OTLP_ENDPOINT=
SERVICE_NAME=network-agents

# MCP TS (packages/mcp, apps/api): auth e politica de tools
# packages/mcp/src/server/McpAuth.ts
MCP_SERVER_KEYS=
# packages/mcp/src/server/McpAuth.ts (so para dev local)
MCP_ALLOW_UNAUTHENTICATED=
# packages/mcp/src/client/MCPClient.ts
MCP_CLIENT_KEY=
# packages/mcp/src/tools/ToolPolicy.ts
MCP_POLICY_PROFILE=
# packages/mcp/src/tools/ToolPolicy.ts
MCP_POLICY_KEY=
# packages/mcp/src/tools/ToolPolicy.ts
MCP_POLICY_ALLOW_MUTATE=
# packages/mcp/src/tools/ToolPolicy.ts, ActionReceipt.ts
MCP_AUDIT_LOG_PATH=
# packages/mcp/src/tools/ActionReceipt.ts
MCP_RECEIPTS_LOG_PATH=
# apps/api/src/middleware/auth.ts (so para dev local)
ALLOW_UNAUTHENTICATED=

# Testes e2e TS (tests/e2e)
E2E_BASE_URL=
E2E_API_KEY=

# Runner Python (runner/plan_runner, scripts/)
# worker external, router, embedder, L4 (external_worker.py, embedder.py, memory_l4.py)
GEMINI_API_KEY=
# modelo do worker/router/conselho; vazio = gemini-flash-lite-latest
AGENT_MODEL=
# opt (omissao) | legacy (context_policy.py)
PLAN_RUNNER_CONTEXT=
# L5: MCP de producao para o retrieve (mcp_knowledge.py)
MCP_URL=
# L5: chave do MCP (mcp_knowledge.py)
MCP_API_KEY=
# ledger de tokens remoto (external_worker.py); vazio = so token_usage.jsonl local
SUPABASE_URL=
# ledger de tokens remoto (external_worker.py)
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL (acima) tambem e lida pelo ingest (supabase_writer.py) e pela L4 (memory_l4.py, memory_wiring.py)
# opcional: commit gravado em knowledge_sources (ingest; no CI vem do GITHUB_SHA)
GIT_SHA=

# MCP plan_runner (mcp/plan_runner/mcp_plan_runner/policy.py)
# omissao: moderate
PLAN_RUNNER_MCP_PROFILE=
PLAN_RUNNER_MCP_KEY=
PLAN_RUNNER_MCP_CALLER=
PLAN_RUNNER_MCP_ALLOW_MUTATE=
PLAN_RUNNER_REPO_ROOT=

# Testes do RAG/L4 (runner/tests): Postgres DESCARTAVEL com pgvector, nunca o de producao
RAG_TEST_DATABASE_URL=
# 1 no CI: falta da BD e erro, nao skip
RAG_TEST_REQUIRED=
