{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-agents-setup.local/schemas/CriticReport.schema.json",
  "title": "CriticReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass", "gaps", "item13_score", "publish_ready"],
  "properties": {
    "pass": { "type": "boolean" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "message": { "type": "string", "minLength": 1 },
          "field": { "type": "string" }
        }
      }
    },
    "item13_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "publish_ready": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
