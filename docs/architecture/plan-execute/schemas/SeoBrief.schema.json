{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network-agents-setup.local/schemas/SeoBrief.schema.json",
  "title": "SeoBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_primary",
    "queries",
    "unique_promise",
    "title",
    "meta_description",
    "h1",
    "h2_outline",
    "faq",
    "cannibalization_risks",
    "item13_notes",
    "cta_primary"
  ],
  "properties": {
    "intent_primary": { "type": "string", "minLength": 1 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unique_promise": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 70 },
    "meta_description": { "type": "string", "minLength": 1, "maxLength": 160 },
    "h1": { "type": "string", "minLength": 1 },
    "h2_outline": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "faq": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer_draft"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "answer_draft": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cannibalization_risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "item13_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cta_primary": { "type": "string", "minLength": 1 }
  }
}
