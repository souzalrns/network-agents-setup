generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  preferencesJson   Json?     @map("preferences")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  executions        Execution[]
  conversations     Conversation[]
  preferences       UserPreference[]
  @@map("users")
}
model UserPreference {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  key           String
  value         Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  @@unique([userId, key])
  @@map("user_preferences")
}
model Conversation {
  id            String      @id @default(cuid())
  title         String?
  userId        String?     @map("user_id")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastMessageAt DateTime    @default(now())
  messageCount  Int         @default(0)
  user          User?       @relation(fields: [userId], references: [id])
  executions    Execution[]
  messages      Message[]
  @@map("conversations")
}
model Message {
  id            String    @id @default(cuid())
  conversationId String   @map("conversation_id")
  role          String
  content       String    @db.Text
  agentId       String?   @map("agent_id")
  metadata      Json?
  createdAt     DateTime  @default(now())
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  @@map("messages")
}
model Execution {
  id            String    @id @default(cuid())
  status        String
  domain        String?   @db.VarChar(50)
  intent        String
  message       String    @db.Text
  result        String?   @db.Text
  errors        String?   @db.Text
  steps         Json?
  metadata      Json?
  totalTokens   Int?      @default(0)
  totalCost     Float?    @default(0)
  durationMs    Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  conversationId String?   @map("conversation_id")
  userId         String?   @map("user_id")
  conversation  Conversation? @relation(fields: [conversationId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  checkpoints   Checkpoint[]
  logs          ExecutionLog[]
  @@map("executions")
}
model Checkpoint {
  id            String    @id @default(cuid())
  executionId   String    @map("execution_id")
  hitlRequestId String    @map("hitl_request_id")
  stepIndex     Int       @map("step_index")
  state         Json
  memorySnapshot Json
  createdAt     DateTime  @default(now())
  restoredAt    DateTime?
  execution     Execution @relation(fields: [executionId], references: [id])
  @@map("checkpoints")
}
model ExecutionLog {
  id            String    @id @default(cuid())
  executionId   String    @map("execution_id")
  level         String
  message       String    @db.Text
  metadata      Json?
  timestamp     DateTime  @default(now())
  execution     Execution @relation(fields: [executionId], references: [id])
  @@map("execution_logs")
}
model Metrics {
  id            String    @id @default(cuid())
  date          DateTime  @default(now())
  agentId       String?   @map("agent_id")
  executions    Int       @default(0)
  tokens        Int       @default(0)
  cost          Float     @default(0)
  durationMs    Int       @default(0)
  errors        Int       @default(0)
}
model LegalDocument {
  id            String    @id @default(cuid())
  title         String
  type          String
  jurisdiction  String
  number        String?
  year          String?
  summary       String?   @db.Text
  content       String?   @db.Text
  url           String?
  source        String
  metadata      Json
  embedding     Unsupported("vector")?
  tags          String[]
  relatedDocs   String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([type, jurisdiction, source])
  @@index([jurisdiction, tags])
}

// ===== T6 — Ingestao de knowledge (RAG L5) =====
// Design: docs/T6-INGEST-PIPELINE.md secao 4 (Modelo de dados).
// Tabelas exclusivas do network-agents-setup (nao partilha com agent-network-mcp).
// Requer a extensao pgvector:
//   CREATE EXTENSION IF NOT EXISTS vector;

model KnowledgeSource {
  sourcePath      String   @id @map("source_path")
  contentHash     String   @map("content_hash")
  agentId         String   @map("agent_id")
  priority        String   @default("P1")
  lastIngestedAt  DateTime @default(now()) @map("last_ingested_at")
  chunkCount      Int      @default(0) @map("chunk_count")
  gitSha          String?  @map("git_sha")
  sizeBytes       Int?     @map("size_bytes")
  updatedAt       DateTime @updatedAt @map("updated_at")
  chunks          KnowledgeChunk[]

  @@index([agentId, priority])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  sourcePath  String   @map("source_path")
  contentHash String   @map("content_hash")
  chunkIndex  Int      @map("chunk_index")
  content     String   @db.Text
  agentId     String   @map("agent_id")
  kb          String   @default("marketing")
  embedding   Unsupported("vector")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  source      KnowledgeSource @relation(fields: [sourcePath], references: [sourcePath], onDelete: Cascade)

  @@unique([sourcePath, chunkIndex])
  @@index([kb, agentId])
  @@index([contentHash])
  @@map("knowledge_chunks_t6")
}

model SystemInventory {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  gitSha    String?  @map("git_sha")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_inventory")
}