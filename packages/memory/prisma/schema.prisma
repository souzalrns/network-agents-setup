generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  // Renomeado de "preferences" para "preferencesJson" (mantendo a coluna "preferences" no banco
  // via @map) para não colidir com a relação "preferences" abaixo — o schema original enviado
  // pelo usuário declarava os dois campos com o mesmo nome, o que o Prisma rejeita.
  preferencesJson   Json?     @map("preferences")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  executions        Execution[]
  conversations     Conversation[]
  preferences       UserPreference[]
  @@map("users")
}
model UserPreference {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  key           String
  value         Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  @@unique([userId, key])
  @@map("user_preferences")
}
model Conversation {
  id            String      @id @default(cuid())
  title         String?
  userId        String?     @map("user_id")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastMessageAt DateTime    @default(now())
  messageCount  Int         @default(0)
  user          User?       @relation(fields: [userId], references: [id])
  executions    Execution[]
  messages      Message[]
  @@map("conversations")
}
model Message {
  id            String    @id @default(cuid())
  conversationId String   @map("conversation_id")
  role          String
  content       String    @db.Text
  agentId       String?   @map("agent_id")
  metadata      Json?
  createdAt     DateTime  @default(now())
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  @@map("messages")
}
model Execution {
  id            String    @id @default(cuid())
  status        String
  domain        String?   @db.VarChar(50)
  intent        String
  message       String    @db.Text
  result        String?   @db.Text
  errors        String?   @db.Text
  steps         Json?
  metadata      Json?
  totalTokens   Int?      @default(0)
  totalCost     Float?    @default(0)
  durationMs    Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  conversationId String?   @map("conversation_id")
  userId         String?   @map("user_id")
  conversation  Conversation? @relation(fields: [conversationId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  checkpoints   Checkpoint[]
  logs          ExecutionLog[]
  @@map("executions")
}
model Checkpoint {
  id            String    @id @default(cuid())
  executionId   String    @map("execution_id")
  hitlRequestId String    @map("hitl_request_id")
  stepIndex     Int       @map("step_index")
  state         Json
  memorySnapshot Json
  createdAt     DateTime  @default(now())
  restoredAt    DateTime?
  execution     Execution @relation(fields: [executionId], references: [id])
  @@map("checkpoints")
}
model ExecutionLog {
  id            String    @id @default(cuid())
  executionId   String    @map("execution_id")
  level         String
  message       String    @db.Text
  metadata      Json?
  timestamp     DateTime  @default(now())
  execution     Execution @relation(fields: [executionId], references: [id])
  @@map("execution_logs")
}
model Metrics {
  id            String    @id @default(cuid())
  date          DateTime  @default(now())
  agentId       String?   @map("agent_id")
  executions    Int       @default(0)
  tokens        Int       @default(0)
  cost          Float     @default(0)
  durationMs    Int       @default(0)
  errors        Int       @default(0)
  @@map("metrics")
}

// ===== Ingestão Inicial: Direito BR/PT (proof-of-concept da pipeline de conhecimento) =====
// Modelo colado literalmente pelo usuário. Duas correções de tipo foram necessárias porque
// o próprio código de ingestão colado (scripts/ingest/brazilian-law.ts e jurisprudence.ts)
// sempre atribui `year` e `number` como string (ex.: "2002", vindos de listas hardcoded ou
// de `new Date().getFullYear().toString()`) e sempre passa `metadata` preenchido em todo
// `create()` — o material original já declarava `year String?` e `metadata Json`
// (não `Int?`/`Json?`); mantido assim para bater com o uso real.
// Sem "@@map"/"@map": segue o texto colado ao pé da letra (tabela fica "LegalDocument",
// o nome padrão que o Prisma usa quando nenhum @@map é declarado) — isso é o que faz
// `UPDATE "LegalDocument" SET embedding = ...` em scripts/ingest/embeddings.ts (também
// colado literalmente) bater com o nome real da tabela.
model LegalDocument {
  id            String    @id @default(cuid())
  title         String
  type          String    // lei, decreto, jurisprudencia, doutrina, norma, parecer
  jurisdiction  String    // BR, PT, EU
  number        String?
  year          String?
  summary       String?   @db.Text
  content       String?   @db.Text
  url           String?
  source        String
  metadata      Json
  // NOTA DE FIDELIDADE: campo pgvector, como no material colado. "Unsupported" é o
  // escape-hatch nativo do Prisma para tipos sem suporte de 1a classe (aqui, o tipo
  // "vector" da extensão pgvector). Antes de rodar `prisma migrate dev` contra um
  // Postgres real, é necessário habilitar a extensão manualmente:
  //   CREATE EXTENSION IF NOT EXISTS vector;
  // (não foi possível validar isso neste ambiente, que não tem Postgres ativo nem
  // acesso de rede aos binários do Prisma — ver relatório final.)
  embedding     Unsupported("vector")?
  tags          String[]
  relatedDocs   String[]  // IDs de documentos relacionados
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([type, jurisdiction, source])
  @@index([jurisdiction, tags])
}
